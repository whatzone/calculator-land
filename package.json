{
  "name": "clearfigures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run manifest:build && npm run host:config && astro build && npm run seo:audit",
    "preview": "astro preview",
    "preview:static": "tsx scripts/preview-server.ts",
    "astro": "astro",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "manifest:build": "tsx scripts/build-page-manifest.ts",
    "host:config": "tsx scripts/build-host-config.ts",
    "host:check": "tsx scripts/build-host-config.ts --check",
    "tax:audit": "tsx scripts/audit-tax-data.ts",
    "seo:audit": "tsx scripts/check-indexability.ts && tsx scripts/check-links.ts",
    "create:calculator": "tsx scripts/create-calculator.ts",
    "create:jurisdiction": "tsx scripts/create-jurisdiction.ts",
    "gate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run tax:audit && npm run build"
  },
  "dependencies": {
    "astro": "^7.2.10",
    "big.js": "^7.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/big.js": "^6.2.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.3.1",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
