---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site.ts';
import { JURISDICTIONS, findRuleset } from '../data/jurisdictions/index.ts';
import {
  calculatorPath,
  globalCalculatorList,
  isCalculatorIndexable,
} from '../lib/registry/index.ts';
import { manifestEntry } from '../lib/seo/pages.ts';
import { summariseManifest } from '../lib/seo/manifest.ts';

const path = '/';
const entry = manifestEntry(path);
const globals = globalCalculatorList();
const summary = summariseManifest();
const liveCount = globals.filter(isCalculatorIndexable).length;

/** Numbers under ten read better spelled out in running prose. */
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
const liveCountWord = WORDS[liveCount] ?? String(liveCount);
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.valueProposition}
  path={path}
  indexable={entry?.indexable ?? false}
  crumbs={[{ name: 'Home', path: '/' }]}
>
  <div class="page-head page-head--hero">
    <h1>Know exactly what you take home.</h1>
    <p class="lede">
      Transparent salary, tax and mortgage calculators. Every deduction itemised, every rule linked
      to the authority that sets it, every assumption stated beside the answer.
    </p>

    <ul class="hero-facts">
      <li>
        <span class="fact__label">Markets</span>
        <span class="fact__value">5</span>
      </li>
      <li>
        <span class="fact__label">Calculators</span>
        <span class="fact__value">23</span>
      </li>
      <li>
        <span class="fact__label">Cost</span>
        <span class="fact__value">Free</span>
      </li>
      <li>
        <span class="fact__label">Data collected</span>
        <span class="fact__value">None</span>
      </li>
    </ul>
  </div>

  <section aria-labelledby="live-heading">
    <div class="section-head">
      <h2 id="live-heading">Ready to use</h2>
      <p>
        These {liveCountWord} tools are arithmetic rather than tax rules, so they work the same Each shows
        its formula and its assumptions on the page.
      </p>
    </div>
    <ul class="card-grid">
      {
        globals.map((calculator) => (
          <li>
            <a class="tool-card" href={calculatorPath(calculator)}>
              <strong>{calculator.shortTitle}</strong>
              <p>{calculator.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="countries-heading">
    <div class="section-head">
      <h2 id="countries-heading">By country</h2>
      <p>
        Salary, net-to-gross, bonus and pay-rise calculators are built for all five launch markets.
        Each stays offline until its rules have been read from the tax authority that publishes them
        and checked by a person — so today they show you their sources instead of a figure.
      </p>
    </div>
    <ul class="card-grid">
      {
        JURISDICTIONS.map((meta) => {
          const ruleset = findRuleset(meta.code);
          const pending = ruleset?.provenance.dataStatus !== 'populated';
          return (
            <li>
              <a
                class={`tool-card ${pending ? 'tool-card--disabled' : ''}`}
                href={`/${meta.slug}/`}
              >
                <strong>{meta.adjective}</strong>
                <p>
                  Tax period {ruleset?.taxPeriod.label ?? 'unknown'}.
                  {meta.regions.length > 0 &&
                    ` Includes ${meta.regions.map((region) => region.label).join(', ')}.`}
                </p>
                {pending && <span class="pill pill--pending">Not available yet</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="card" aria-labelledby="why-heading">
    <h2 id="why-heading" style="margin-top:0;">Read this before you rely on a number</h2>
    <p>
      The tax rates on this site have <strong
        >not been checked against the authorities that publish them</strong
      >. They were entered from general knowledge. The calculations themselves are tested and sound
      — which bands apply, how allowances taper, how contributions are capped — but the specific
      figures may be out of date, and thresholds usually change at the start of each tax year.
    </p>
    <p>
      So: useful for sanity-checking a payslip or comparing two salaries, not for a decision that
      turns on the exact figure. Every calculator page says the same, and links to the official
      source so you can check it yourself.
    </p>
    <p style="margin-bottom:0;">
      {summary.withheld} of {summary.total} pages are held back entirely, because their rules cannot yet
      be modelled correctly. The <a href="/tax-data-updates/">tax data update log</a> shows which, and
      why.
    </p>
  </section>
</BaseLayout>
