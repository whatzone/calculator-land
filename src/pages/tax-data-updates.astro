---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ALL_RULESETS } from '../data/jurisdictions/index.ts';
import { withheldPages, summariseManifest } from '../lib/seo/manifest.ts';
import { manifestEntry } from '../lib/seo/pages.ts';
import { formatDate } from '../lib/formatting/index.ts';

const path = '/tax-data-updates/';
const entry = manifestEntry(path);
const summary = summariseManifest();

// Group withheld pages by reason so the list is a diagnosis, not a wall of URLs.
const reasons = new Map<string, number>();
for (const page of withheldPages()) {
  for (const blocker of page.blockers) {
    reasons.set(blocker, (reasons.get(blocker) ?? 0) + 1);
  }
}
const sortedReasons = [...reasons.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title={entry?.title ?? ''}
  description={entry?.description ?? ''}
  path={path}
  indexable={entry?.indexable ?? false}
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'Tax data updates', path },
  ]}
>
  <div class="page-head">
    <h1>Tax data update log</h1>
    <p class="lede">
      A dated record of every change to the rules behind these calculators, and of everything
      currently being held back.
    </p>
  </div>

  <section aria-labelledby="current-heading">
    <h2 id="current-heading">Current state</h2>
    <p>
      {summary.indexable} of {summary.total} pages currently pass the quality gate.
      {summary.withheld} are held back and are excluded from the sitemap and from search results.
    </p>
    <div
      class="table-scroll"
      tabindex="0"
      role="region"
      aria-label="Why pages are being held back, scrollable"
    >
      <table class="data">
        <caption>Why pages are being held back</caption>
        <thead><tr><th scope="col">Reason</th><th scope="col">Pages affected</th></tr></thead>
        <tbody>
          {
            sortedReasons.map(([reason, count]) => (
              <tr>
                <>
                  <th scope="row">{reason}</th>
                  <td>{count}</td>
                </>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="rulesets-heading">
    <h2 id="rulesets-heading">Rulesets</h2>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Rulesets, scrollable">
      <table class="data">
        <thead>
          <tr>
            <th scope="col">Ruleset</th>
            <th scope="col">Period</th>
            <th scope="col">Status</th>
            <th scope="col">Checked</th>
            <th scope="col">Expires</th>
          </tr>
        </thead>
        <tbody>
          {
            ALL_RULESETS.map((ruleset) => (
              <tr>
                <th scope="row">{ruleset.id}</th>
                <td style="text-align:left;">{ruleset.taxPeriod.label}</td>
                <td style="text-align:left;">
                  {ruleset.status} / {ruleset.provenance.dataStatus}
                </td>
                <td style="text-align:left;">
                  {ruleset.provenance.checkedOn
                    ? formatDate(ruleset.provenance.checkedOn)
                    : 'never'}
                </td>
                <td style="text-align:left;">{formatDate(ruleset.expiresOn)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="log-heading">
    <h2 id="log-heading">Change log</h2>
    <h3>4 September 2026 — a choice of tax year, and New Zealand withdrawn</h3>
    <p>
      Every salary calculator now offers a choice of tax year and recalculates against the year you
      pick. Three years are held for each market: 2026/27, 2025/26 and 2024/25 in the United Kingdom
      and Scotland; 2026, 2025 and 2024 in Ireland and Canada; 2026-27, 2025-26 and 2024-25 in
      Australia. Each year carries its own confidence note, because a completed tax year whose rules
      can no longer change and a current year whose thresholds may already have moved do not deserve
      the same caveat.
    </p>
    <p>
      <strong>New Zealand has been withdrawn.</strong> Its income tax thresholds changed part-way through
      the 2024-25 year, which left that year impossible to model honestly as a single set of rates — and
      a market we cannot cover consistently across the years we offer is better absent than partial. The
      New Zealand pages and calculators have been removed rather than left showing a gap.
    </p>
    <p>
      Two figures are knowingly approximated where a rate changed mid-year, both stated on the pages
      that use them: Canadian federal tax for 2025 uses a blended 14.5% lowest rate, and Irish PRSI
      for 2024 uses 4% for the whole year. Both are right for a full-year salary and slightly wrong
      for income concentrated in one half of it.
    </p>

    <h3>3 September 2026 — rates entered, unverified</h3>
    <p>
      Rates were entered for the United Kingdom (including Scotland), Ireland, Australia, New
      Zealand and Canada (federal, Ontario, British Columbia and Alberta), and those calculators
      were switched on. <strong
        >None of these figures has been checked against the authority that publishes it.</strong
      > They were entered from general knowledge because the official websites were unreachable from the
      build environment. Every affected page says so, and the full list of what is least certain is kept
      in the repository at <code>docs/RATE-AMBIGUITIES.md</code>.
    </p>
    <p>
      Quebec was deliberately not switched on. Its rules cannot be modelled correctly yet: it
      collects its own provincial tax, runs QPP in place of CPP, adds QPIP, and reduces federal tax
      by the Quebec abatement — and that last one is a reduction of another layer's tax, which the
      engine has no construct for. Publishing it in the shape used for other provinces would be
      wrong by thousands of dollars rather than merely out of date.
    </p>
    <p>
      Four calculation shapes were added at the same time, because without them the figures could
      not have been entered faithfully: levies charged on whole income with a shade-in band,
      allowance and credit tapers that stop at a floor, surtaxes charged on tax rather than income,
      and income-contingent loan repayments.
    </p>

    <h3>3 September 2026 — initial build</h3>
    <p>
      The calculation engines, tests, page templates, and quality gate were built and verified for
      all five launch markets. Rate tables were left empty: the build environment could not reach
      any tax authority's website, and filling them in from memory or from third-party summaries is
      not something this project will do.
    </p>
    <p>
      The consequence is deliberate. Every salary and tax page is held out of the index until a
      person has opened each official source, entered the figures, added worked-example tests, and
      published the ruleset. Nothing needs to be rebuilt for that to happen — the pages generate
      themselves once the data is there.
    </p>
  </section>
</BaseLayout>
