---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site.ts';
import { manifestEntry } from '../lib/seo/pages.ts';
const path = '/corrections/';
const entry = manifestEntry(path);
---

<BaseLayout
  title={entry?.title ?? ''}
  description={entry?.description ?? ''}
  path={path}
  indexable={entry?.indexable ?? false}
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'Corrections', path },
  ]}
>
  <div>
    <h1>Report an error</h1>
    <p class="lede">
      If a figure here is wrong, we want to know. A financial calculator that quietly stays wrong is
      worse than no calculator.
    </p>
  </div>

  <section aria-labelledby="how">
    <h2 id="how">What to send</h2>
    <p>Email <a href={`mailto:${SITE.correctionsEmail}`}>{SITE.correctionsEmail}</a> with:</p>
    <ul>
      <li>the page address;</li>
      <li>the figures you entered;</li>
      <li>the result you expected, and where that expectation comes from;</li>
      <li>a link to the official source, if you have one.</li>
    </ul>
    {
      SITE.isPlaceholderContact && (
        <div class="notice notice--warning" data-config-disclosure>
          <p class="notice__title">This address is a placeholder</p>
          <p style="margin-bottom:0;">
            A working contact address has not yet been configured for this deployment. It is set in
            one place, <code>src/config/site.ts</code>, and must be replaced before launch.
          </p>
        </div>
      )
    }
  </section>

  <section aria-labelledby="what-happens">
    <h2 id="what-happens">What happens next</h2>
    <ol>
      <li>We try to reproduce it, and write a failing test if we can.</li>
      <li>
        If a rule is wrong, we re-check it against the official source and correct the ruleset.
      </li>
      <li>
        If a figure was materially wrong, the affected pages come out of the index until it is
        fixed.
      </li>
      <li>
        The change is recorded on the <a href="/tax-data-updates/">tax data update log</a>, dated.
      </li>
    </ol>
    <p>
      We will not quietly amend a wrong number and pretend it never happened. Corrections that
      changed a published figure are logged.
    </p>
  </section>
</BaseLayout>
