---
/**
 * The provenance notice shown wherever a jurisdiction's figures are not
 * verified against the authority that publishes them.
 *
 * This is the most important component on the site. The owner asked for working
 * calculators knowing the rates could not be checked from the build
 * environment. That is a defensible choice — a working calculator with an
 * honest health warning is more useful than a blank page — but it is only
 * defensible while the warning is impossible to miss and impossible to remove
 * by accident. So this renders above the result, it is not dismissible, and
 * `scripts/check-indexability.ts` fails the build if a page carrying unverified
 * figures ships without it.
 *
 * It used to say all of that in three paragraphs, which is how a warning stops
 * being read: at that length it reads as boilerplate and the eye skips it. The
 * claim a reader must not miss is one sentence, so that is what is shown. The
 * reasoning behind it is a disclosure below, for the reader who wants it. The
 * warning is quieter, not weaker — nothing was removed, and the enforcement is
 * unchanged.
 */
import { formatDate } from '../../lib/formatting/index.ts';
import type { Ruleset } from '../../lib/validation/ruleset-schema.ts';

interface Props {
  ruleset: Ruleset;
  jurisdictionName: string;
}
const { ruleset, jurisdictionName } = Astro.props;

const status = ruleset.provenance.dataStatus;
const authority = jurisdictionName === 'the UK' ? 'HMRC' : 'the tax authority';
---

{
  status === 'awaiting-official-source' && (
    <div class="notice notice--unsupported" role="note" data-provenance="awaiting-official-source">
      <p class="notice__title">This calculator is not live yet</p>
      <p style="margin-bottom:0;">
        The {ruleset.taxPeriod.label} rules for {jurisdictionName} have not been entered, so this
        page will not show you a figure. Publishing a take-home number that nobody has checked
        against the tax authority would be worse than showing none at all. Every source it needs is
        listed below, with links straight to the authority.
      </p>
    </div>
  )
}

{
  status === 'unverified' && (
    <div class="notice notice--warning notice--compact" role="note" data-provenance="unverified">
      <p class="notice__title">These figures have not been checked against the official source</p>
      <p>
        The <span data-provenance-period>{ruleset.taxPeriod.label}</span> rates here were entered
        from general knowledge, not read from {authority}. Treat the result as an estimate to
        sanity-check.
      </p>

      <details class="notice__more">
        <summary>Why, and what that does and does not affect</summary>
        <div class="stack">
          <p>
            The structure of the calculation — which bands apply, how allowances taper, how
            contributions are capped — is tested and sound. It is the specific numbers that may be
            out of date, and thresholds usually change at the start of each tax year.
          </p>
          {ruleset.exclusions.length > 0 && (
            <p style="margin-bottom:0;">
              What this leaves out for {jurisdictionName}, and the assumptions behind it, are listed
              under <strong>What this assumes</strong> below.
            </p>
          )}
          <p style="margin-bottom:0;">
            The official sources are linked below, each marked as unchecked. Tax period{' '}
            {ruleset.taxPeriod.label} runs {formatDate(ruleset.taxPeriod.startDate)} to{' '}
            {formatDate(ruleset.taxPeriod.endDate)}. If you spot an error, please{' '}
            <a href="/corrections/">tell us</a> — corrections are logged and dated.
          </p>
        </div>
      </details>
    </div>
  )
}
