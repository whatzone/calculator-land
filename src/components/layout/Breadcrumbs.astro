---
interface Crumb {
  name: string;
  path: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

{
  crumbs.length > 1 && (
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((crumb, index) => (
          <li>
            {index === crumbs.length - 1 ? (
              <span aria-current="page">{crumb.name}</span>
            ) : (
              <a href={crumb.path}>{crumb.name}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
