---
/**
 * The shared calculator page body.
 *
 * Every calculator route renders this, so form layout, result ordering, ad
 * placement, assumptions, sources, and related links are defined once. Adding a
 * calculator needs no edit here.
 */
import CalculatorForm from './CalculatorForm.astro';
import ResultPanel from './ResultPanel.astro';
import Assumptions from '../content/Assumptions.astro';
import Sources from '../content/Sources.astro';
import DataStatusNotice from '../content/DataStatusNotice.astro';
import AdSlot from '../monetisation/AdSlot.astro';
import { calculatorPath, getCalculator } from '../../lib/registry/index.ts';
import type { AnyCalculatorDefinition, ResultViewModel } from '../../lib/registry/types.ts';
import type { Ruleset } from '../../lib/validation/ruleset-schema.ts';
import type { CalculationContext } from '../../lib/calculations/common/types.ts';

interface Props {
  calculator: AnyCalculatorDefinition;
  view: ResultViewModel;
  context: CalculationContext;
  values: Record<string, string | number | boolean>;
  rulesets: Record<string, Ruleset>;
  primaryRuleset?: Ruleset | null;
  jurisdictionName?: string;
  isPrefilled?: boolean;
}

const {
  calculator,
  view,
  context,
  values,
  rulesets,
  primaryRuleset = null,
  jurisdictionName = '',
  isPrefilled = false,
} = Astro.props;

const path = calculatorPath(calculator);
const assumptionTexts = calculator.assumptions.map((assumption) => assumption.text);
const related = calculator.relatedCalculatorIds
  .map((id) => getCalculator(id))
  .filter((item): item is AnyCalculatorDefinition => item !== undefined);

// When the ruleset is unpopulated, DataStatusNotice carries the full
// explanation, so the engine's shorter version is suppressed above it.
const awaitingSource =
  primaryRuleset !== null && primaryRuleset.provenance.dataStatus === 'awaiting-official-source';

// A calculator opened with nothing filled in has no answer to give, and
// rendering "£0" beside an empty form reads as a broken calculator rather than
// an empty one. Now that the form and the result share a screen, that zero is
// the first thing a reader sees, so the result panel shows a prompt instead
// until there is something to calculate. The client script replaces this the
// moment the form is submitted.
const awaitingInput =
  !isPrefilled &&
  calculator.fields.some(
    (field) =>
      field.required &&
      (field.type === 'money' || field.type === 'number') &&
      (values[field.name] === undefined || values[field.name] === '' || values[field.name] === 0),
  );

const clientConfig = {
  calculatorId: calculator.id,
  family: calculator.family,
  jurisdiction: (calculator.jurisdictions as readonly string[])[0] ?? 'global',
  context,
  isPrefilled,
  rulesets,
};
---

<div class="calc-grid">
  <div class="calc-grid__input">
    <CalculatorForm calculator={calculator} values={values} actionPath={path} />
  </div>

  <div class="calc-grid__output">
    {
      primaryRuleset && (
        <DataStatusNotice ruleset={primaryRuleset} jurisdictionName={jurisdictionName} />
      )
    }

    <ResultPanel
      view={view}
      suppressUnsupportedNotices={awaitingSource}
      awaitingInput={awaitingInput}
    />

    <div class="no-print" data-print-wrap hidden={awaitingInput}>
      <button class="btn btn--quiet" type="button" data-print>Print or save this result</button>
    </div>
  </div>
</div>

<AdSlot slot="post-result" />

<Assumptions
  assumptions={assumptionTexts}
  limitations={calculator.limitations}
  exclusions={primaryRuleset?.exclusions ?? []}
  jurisdictionName={jurisdictionName}
/>

<Sources sources={calculator.sources} />

{
  related.length > 0 && (
    <section aria-labelledby="related-heading">
      <h2 id="related-heading">Related calculators</h2>
      <ul class="card-grid">
        {related.map((item) => (
          <li>
            <a class="tool-card" href={calculatorPath(item)}>
              <strong>{item.shortTitle}</strong>
              <p>{item.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<script
  id="calculator-config"
  type="application/json"
  set:html={JSON.stringify(clientConfig)}
  is:inline
/>
<script>
  import '../../scripts/calculator-client.ts';
</script>
