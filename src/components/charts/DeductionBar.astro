---
/**
 * A single slim bar showing where the money goes.
 *
 * Drawn with CSS rather than a charting library: it is a few hundred bytes, it
 * inherits the theme, and every segment already exists as a row in the table
 * below it. Because nothing here is information-bearing on its own, the bar is
 * aria-hidden and the table is the accessible source of truth.
 *
 * One hue stepped by lightness, so the bar reads as a single quantity being
 * divided rather than as five unrelated categories. Take-home pay is the one
 * segment that gets a semantic colour, because it is the one that means
 * something different from the others.
 */
interface Segment {
  label: string;
  value: number;
  percent: number;
}
interface Props {
  segments: Segment[];
  caption?: string;
}
const { segments, caption } = Astro.props;

const SERIES = [
  'var(--series-1)',
  'var(--series-2)',
  'var(--series-3)',
  'var(--series-4)',
  'var(--series-5)',
];

/**
 * Spread the segments across the whole ramp rather than taking the first N.
 * A two-segment bar using steps 1 and 2 is two nearly identical blues; using
 * the ends of the ramp keeps them legible at any segment count.
 */
const colourFor = (label: string, index: number, count: number): string => {
  if (label === 'Take-home pay') return 'var(--good)';
  const step = count <= 1 ? 0 : Math.round((index * (SERIES.length - 1)) / (count - 1));
  return SERIES[step] ?? 'var(--series-3)';
};

// Segments below half a percent are invisible at any realistic width and would
// only add noise to the key.
const visible = segments.filter((segment) => segment.percent >= 0.5);
---

{
  visible.length > 1 && (
    <figure style="margin:0;">
      <div class="bar" aria-hidden="true">
        {visible.map((segment, index) => (
          <span
            style={`width:${segment.percent}%;background:${colourFor(segment.label, index, visible.length)};`}
          />
        ))}
      </div>
      <ul class="bar-key">
        {visible.map((segment, index) => (
          <li>
            <i
              style={`background:${colourFor(segment.label, index, visible.length)};`}
              aria-hidden="true"
            />
            <span>
              {segment.label} <span class="muted">{segment.percent.toFixed(1)}%</span>
            </span>
          </li>
        ))}
      </ul>
      {caption && (
        <figcaption class="small muted" style="margin-top:0.75rem;">
          {caption}
        </figcaption>
      )}
    </figure>
  )
}
