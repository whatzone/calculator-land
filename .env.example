# Copy to .env for local development. Never commit a filled-in .env.
#
# Every value here has a safe default, and the defaults are deliberately the
# ones that keep the site private and un-monetised: no indexing, no analytics,
# no ads.

# --- Identity -----------------------------------------------------------
# The canonical origin, with no trailing slash. Must be the real production
# domain before indexing is enabled; the indexability audit refuses to allow
# indexing while this is still the placeholder.
SITE_URL=https://clearfigures.pages.dev
SITE_NAME=ClearFigures
SITE_CONTACT_EMAIL=hello@example-clearfigures.invalid
SITE_CORRECTIONS_EMAIL=

# --- Indexing -----------------------------------------------------------
# The master switch. Anything other than "true" makes every page noindex and
# empties the sitemap. Set it only on the production deployment.
SITE_ALLOW_INDEXING=false

# --- Measurement --------------------------------------------------------
# Cloudflare Web Analytics token. Cookie-light; loads when set.
CF_ANALYTICS_TOKEN=
# GA4 measurement ID. Loads only when set AND a consent choice permits it.
GA4_MEASUREMENT_ID=
# Search Console HTML meta verification token, if using that method.
SEARCH_CONSOLE_VERIFICATION=
# Name of the consent platform in use. GA4 stays off while this is empty.
CMP_PROVIDER=
CONSENT_REQUIRED_BY_DEFAULT=true

# --- Advertising --------------------------------------------------------
# Leave false until there is an approved network account AND a certified
# consent platform configured for UK/EEA traffic.
ADS_ENABLED=false
AD_PUBLISHER_ID=
AD_SLOT_RESULT_RAIL=
AD_SLOT_POST_RESULT=
AD_SLOT_GUIDE_MID=
# ads.txt is generated only from a real publisher line. One line per entry.
ADS_TXT_LINES=
